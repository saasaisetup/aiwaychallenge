# ==============================================================================
# AIWAY CHALLENGE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# INSTRUCTIONS:
# 1. Duplicate this file and rename it to: .env.local
# 2. Fill in your genuine API keys below.
# 3. DO NOT commit .env.local to Git! (.gitignore is already set to protect it).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RAZORPAY PAYMENT GATEWAY (Required for accepting ₹99 payments)
# ------------------------------------------------------------------------------
# Get your keys from: https://dashboard.razorpay.com/app/keys
# For testing: use keys starting with "rzp_test_"
# For production: use keys starting with "rzp_live_"
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# ------------------------------------------------------------------------------
# 2. RESEND EMAIL SERVICE (Required for sending ticket & Google Meet link)
# ------------------------------------------------------------------------------
# Get your API key from: https://resend.com/api-keys
# Free tier gives you 100 emails/day and 3,000 emails/month.
RESEND_API_KEY=re_YOUR_RESEND_API_KEY_HERE

# Sender email:
# During development/testing without a custom domain, use: onboarding@resend.dev
# In production with your custom domain verified on Resend, use: tickets@yourdomain.com
RESEND_FROM_EMAIL=onboarding@resend.dev

# ------------------------------------------------------------------------------
# 3. WORKSHOP & GOOGLE MEET DETAILS (Included in confirmation email & calendar)
# ------------------------------------------------------------------------------
GOOGLE_MEET_LINK=https://meet.google.com/xyz-abcd-efg
WORKSHOP_DATE=Sunday, 19th July 2026
WORKSHOP_TIME=7:00 PM IST
WORKSHOP_PRICE=99

# ------------------------------------------------------------------------------
# 4. OPTIONAL: SUPABASE (Only if you want a custom database of attendees)
# ------------------------------------------------------------------------------
# Not required for basic payments and emails. Only add if you want a Postgres table.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
